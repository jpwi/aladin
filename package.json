{
  "name": "aladin",
  "version": "1.0.0",
  "description": "Local, Notion-like knowledge base that runs in your browser",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "jsdom": "^25.0.0",
    "serve": "^14.2.5",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "notes",
    "knowledge-base",
    "local-first",
    "encryption"
  ],
  "license": "MIT"
}
